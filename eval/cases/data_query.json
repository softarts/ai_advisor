{
  "intent": "data_query",
  "description": "数据查询类用例。期望值取自当前快照 (账户 U9628699, 报告截止 2026-10-09) 的工具实际返回。",
  "cases": [
    {
      "id": "DQ01",
      "name": "过去三年最高/最低收益月份",
      "question": "过去三年哪个月份收益率最高？最低的是哪个月？",
      "expected_tools": ["get_monthly_returns"],
      "must_include": ["2025-03", "4.49", "2025-05", "-4.02"],
      "must_not": [["最高的是 2022-10", "最高为 2022-10", "最高月份是 2022-10"]],
      "expect_note": false
    },
    {
      "id": "DQ02",
      "name": "指定月份区间月末资产",
      "question": "列出 2026 年 9 月到 10 月的月末资产。",
      "expected_tools": ["get_portfolio_detail"],
      "must_include": ["707,216", "713,223", "2026-09", "2026-10"],
      "must_not": [],
      "expect_note": false
    },
    {
      "id": "DQ03",
      "name": "一年期资产变化与基准对比",
      "question": "过去一年资产变化多少？和三个基准比如何？",
      "expected_tools": ["get_window_summary"],
      "must_include": ["532,216", "713,223", ["104,006", "104006"], "19.35", "SPXTR", "EFA", "VT"],
      "must_not": [],
      "expect_note": false
    },
    {
      "id": "DQ04",
      "name": "YTD 收益与基准对比",
      "question": "今年收益如何，比标普好吗？",
      "expected_tools": ["get_window_summary"],
      "must_include": ["16.73", "15.14"],
      "must_not": [],
      "expect_note": false
    },
    {
      "id": "DQ05",
      "name": "YTD 资产类别归因",
      "question": "今年的收益主要来自哪些资产类别？",
      "expected_tools": ["get_attribution"],
      "must_include": ["4,669", "3,898", "5,930", "77,660", "92,088"],
      "must_not": ["期货贡献", "期货期权贡献", "外汇贡献"],
      "expect_note": false
    },
    {
      "id": "DQ06",
      "name": "年度收益最好/最差",
      "question": "哪一年收益最好、哪一年最差？",
      "expected_tools": ["get_yearly_table"],
      "must_include": ["2023", "31.88", "2020", "-50.96"],
      "must_not": [],
      "expect_note": false
    },
    {
      "id": "DQ07",
      "name": "现金利息与隐含收益率",
      "question": "今年现金利息和隐含收益率是多少？",
      "expected_tools": ["get_cash_interest"],
      "must_include": ["5,930", ["-68", "-68.96", "68.96"], "592,820", "1.29"],
      "must_not": [],
      "expect_note": false
    },
    {
      "id": "DQ08",
      "name": "累计盈亏最大合约",
      "question": "历史上盈亏最大的合约是什么？最差的是哪个？",
      "expected_tools": ["get_top_contributors"],
      "must_include": ["ESM5", "107,932", "SPY", "-53,431"],
      "must_not": ["按月", "成交月份"],
      "expect_note": false
    },
    {
      "id": "DQ09",
      "name": "风险指标：回撤与夏普",
      "question": "最大回撤是多少，恢复情况如何？夏普比率是多少？",
      "expected_tools": ["get_risk_measures"],
      "must_include": ["65.20", "75", "0.0610"],
      "must_not": ["日度回撤", "日内回撤"],
      "expect_note": false
    },
    {
      "id": "DQ10",
      "name": "当前持仓与币种现金",
      "question": "现在的持仓配置和 SGD/USD 现金分别是多少？",
      "expected_tools": ["get_open_positions"],
      "must_include": ["2026-10-09", "SGD", "USD", "市值口径"],
      "must_not": ["是风险口径", "杠杆是", "杠杆为"],
      "expect_note": false
    },
    {
      "id": "DQ11",
      "name": "单月归因：收益高的月份",
      "question": "为什么 2025-03 收益这么高？",
      "expected_tools": ["get_month_detail"],
      "must_include": ["4.49", "-5.63", "18,935", "60,000", "3.3", "4,470", ["入金不是收益", "入金不计入收益"], "K3", "K13"],
      "must_not": ["因为某笔交易", "因为某合约", "因为买入", "因为卖出", "是 ES 合约"],
      "expect_note": false
    },
    {
      "id": "DQ12",
      "name": "单月归因：解释归因数据不一致",
      "question": "为什么 2025-04 亏损？",
      "expected_tools": ["get_month_detail"],
      "must_include": ["-3.75", ["归因类别合计与 TWR 不一致", "归因数据与 TWR 对不上", "类别贡献与账户收益不一致", "归因贡献与 TWR 相差", "品种贡献总计与 TWR 相差", "不一致", "相差", "contribution data does not match TWR"], ["不能据此判断亏损来自哪些类别", "不能据此推断具体是哪类资产导致了亏损", "不能据此断定亏损源于哪些合约或交易", "无法可靠判断哪些类别导致亏损", "不能可靠地用类别数据解释亏损", "不能可靠地告诉我们亏损具体来自哪些资产类别", "不能断定亏损主要来源于哪个具体品类或交易", "无法可靠地把亏损归因于哪个具体品类或交易", "无法从归因数据中确切说明亏损的来源", "无法可靠地告诉你是哪些期货、期权或其他资产导致的亏损", "cannot reliably determine which categories caused the loss"]],
      "conditional_tool_value_guards": [
        {
          "tool": "get_month_detail",
          "when": {"path": "contribution_pp.consistency", "equals": "inconsistent"},
          "forbidden_values": [
            {"path": "contribution_pp.etfs", "labels": ["ETF", "股票/ETF"]},
            {"path": "contribution_pp.stocks", "labels": ["股票"]},
            {"path": "contribution_pp.options", "labels": ["股票期权"]},
            {"path": "contribution_pp.futures", "labels": ["期货"]},
            {"path": "contribution_pp.futures_options", "labels": ["期货期权", "期货/期权"]},
            {"path": "contribution_pp.future_style_options", "labels": ["未来风格期权"]},
            {"path": "contribution_pp.cash", "labels": ["现金类", "现金"]}
          ]
        }
      ],
      "must_not": ["股票/ETF 贡献", "股票期权贡献", "期货贡献 +", "期货期权贡献 +", "主要是由于市场整体回调", "主要受市场整体回调", "亏损主要是由于市场整体回调", "市场整体回调加上账户内部组合的表现略逊于基准", "主要受期货和合并的期货/期权拖累", "主要受期货和合并的期货/期权"],
      "expect_note": false
    },
    {
      "id": "DQ13",
      "name": "单月归因：现金类未解释部分",
      "question": "2025-03 现金类为什么有 1.14 个百分点，是美元升值吗？",
      "expected_tools": ["get_month_detail"],
      "must_include": [["无法验证", "不能断言", "无法确定", "来源不明"], "4,470", ["未解释", "无法进一步"], "K13"],
      "must_not": ["因为美元升值", "确实是汇率收益", "美元汇率上涨导致"],
      "expect_note": false
    },
    {
      "id": "DQ14",
      "name": "超出报告能力：逐笔成交时间",
      "question": "每月交易笔数是多少？是不是交易太频繁？",
      "expected_tools": [],
      "optional_tools": ["get_capabilities"],
      "must_include": [["无法回答", "无法提供", "不能回答", "暂不提供", "不提供"], "K8"],
      "must_not": ["到期月份代替成交月份", "用到期月份代理"],
      "expect_note": false
    },
    {
      "id": "DQ15",
      "name": "超出报告能力：杠杆与保证金",
      "question": "这份报告能告诉我账户杠杆是多少吗？",
      "expected_tools": ["get_capabilities"],
      "must_include": [["无法回答", "无法提供", "无法直接告诉"], "K7"],
      "must_not": ["杠杆是 1", "杠杆约为"],
      "expect_note": false
    }
  ]
}
