{
  "intent": "data_query",
  "description": "数据查询类用例。期望值取自当前快照 (账户 U9628699, 报告截止 2026-10-09) 的工具实际返回。",
  "cases": [
    {
      "id": "DQ01",
      "name": "过去三年最高/最低收益月份",
      "question": "过去三年哪个月份收益率最高？最低的是哪个月？",
      "expected_tools": ["get_monthly_returns"],
      "must_include": [],
      "tool_value_assertions": [
        {"tool": "get_monthly_returns", "path": "value.best_month.month"},
        {"tool": "get_monthly_returns", "path": "value.best_month.account_return_pct", "label_path": "value.best_month.month"},
        {"tool": "get_monthly_returns", "path": "value.worst_month.month"},
        {"tool": "get_monthly_returns", "path": "value.worst_month.account_return_pct", "label_path": "value.worst_month.month"}
      ],
      "must_not": [],
      "expect_note": false
    },
    {
      "id": "DQ02",
      "name": "指定月份区间月末资产",
      "question": "列出 2026 年 9 月到 10 月的月末资产。",
      "expected_tools": ["get_portfolio_detail"],
      "must_include": ["2026-09", "2026-10"],
      "tool_value_assertions": [
        {"tool": "get_portfolio_detail", "path": "observations.0.value", "label_path": "observations.0.term_month"},
        {"tool": "get_portfolio_detail", "path": "observations.1.value", "label_path": "observations.1.term_month"}
      ],
      "must_not": [],
      "expect_note": false
    },
    {
      "id": "DQ03",
      "name": "一年期资产变化与基准对比",
      "question": "过去一年资产变化多少？和三个基准比如何？",
      "expected_tools": ["get_window_summary"],
      "must_include": ["SPXTR", "EFA", "VT"],
      "tool_value_assertions": [
        {"tool": "get_window_summary", "path": "value.start_nav", "label": "期初"},
        {"tool": "get_window_summary", "path": "value.end_nav", "label": "期末"},
        {"tool": "get_window_summary", "path": "value.profit", "label": "盈亏"},
        {"tool": "get_window_summary", "path": "value.twr_pct", "label": "TWR"},
        {"tool": "get_window_summary", "path": "value.benchmark_twr_pct.SPXTR", "label": "SPXTR"},
        {"tool": "get_window_summary", "path": "value.benchmark_twr_pct.EFA", "label": "EFA"},
        {"tool": "get_window_summary", "path": "value.benchmark_twr_pct.VT", "label": "VT"}
      ],
      "semantic_fact_paths": [
        {
          "tool": "get_window_summary",
          "paths": [
            "value.start_nav", "value.end_nav", "value.net_flow", "value.profit",
            "value.twr_pct", "value.benchmark_twr_pct"
          ]
        }
      ],
      "must_not": [],
      "semantic_rubric": [
        {
          "id": "compare-window-benchmarks",
          "criterion": "应清楚回答账户过去一年的资产变化/投资盈亏，并将账户 TWR 与所问的三个基准作正确比较；不得混淆资产变化、净流入和投资收益。"
        }
      ],
      "expect_note": false
    },
    {
      "id": "DQ04",
      "name": "YTD 收益与基准对比",
      "question": "今年收益如何，比标普好吗？",
      "expected_tools": ["get_window_summary"],
      "must_include": [],
      "tool_value_assertions": [
        {"tool": "get_window_summary", "path": "value.twr_pct", "label": "TWR"},
        {"tool": "get_window_summary", "path": "value.benchmark_twr_pct.SPXTR", "label": "SPXTR"}
      ],
      "semantic_fact_paths": [
        {
          "tool": "get_window_summary",
          "paths": ["value.twr_pct", "value.benchmark_twr_pct.SPXTR"]
        }
      ],
      "must_not": [],
      "semantic_rubric": [
        {
          "id": "compare-ytd-return",
          "criterion": "应正确比较今年账户 TWR 与 SPXTR，并根据工具数据使用正确的领先/落后结论，不得只罗列数字而不回答比较问题。"
        }
      ],
      "expect_note": false
    },
    {
      "id": "DQ05",
      "name": "YTD 资产类别归因",
      "question": "今年的收益主要来自哪些资产类别？",
      "expected_tools": ["get_attribution"],
      "must_include": [],
      "tool_value_assertions": [
        {"tool": "get_attribution", "path": "value.buckets.0.amount", "label_path": "value.buckets.0.label"},
        {"tool": "get_attribution", "path": "value.buckets.1.amount", "label_path": "value.buckets.1.label"},
        {"tool": "get_attribution", "path": "value.buckets.2.amount", "label_path": "value.buckets.2.label"},
        {"tool": "get_attribution", "path": "value.buckets.3.amount", "label_path": "value.buckets.3.label"},
        {"tool": "get_attribution", "path": "value.buckets.4.amount", "label_path": "value.buckets.4.label"}
      ],
      "semantic_fact_paths": [
        {"tool": "get_attribution", "paths": ["value.buckets", "value.pa_split_reference", "warnings"]}
      ],
      "must_not": [],
      "semantic_rubric": [
        {
          "id": "attribution-answers-question",
          "criterion": "应依据工具正确配对类别和值，并区分股票/ETF、股票期权的估算 SGD 分摊、期货/期货期权/外汇的剩余项与精确利息/费用；不得把估算或剩余项说成 PA 原始逐类报告值、已实现盈亏或确定的交易因果。"
        }
      ],
      "expect_note": false
    },
    {
      "id": "DQ06",
      "name": "年度收益最好/最差",
      "question": "哪一年收益最好、哪一年最差？",
      "expected_tools": ["get_yearly_table"],
      "must_include": [],
      "tool_extrema_assertions": [
        {
          "tool": "get_yearly_table",
          "list_path": "value",
          "value_path": "twr_pct",
          "entity_path": "year",
          "exclude_if": {"path": "partial", "equals": true},
          "modes": ["max", "min"]
        }
      ],
      "semantic_fact_paths": [
        {"tool": "get_yearly_table", "paths": ["value"]}
      ],
      "must_not": [],
      "semantic_rubric": [
        {
          "id": "yearly-extrema-pairing",
          "criterion": "应把工具数据中最高和最低年度收益分别与正确年份配对；不得只罗列年份和值却配错，也不得把 TWR 与官方收益口径混为一谈。"
        }
      ],
      "expect_note": false
    },
    {
      "id": "DQ07",
      "name": "现金利息与隐含收益率",
      "question": "今年现金利息和隐含收益率是多少？",
      "expected_tools": ["get_cash_interest"],
      "must_include": [],
      "tool_value_assertions": [
        {"tool": "get_cash_interest", "path": "value.interest", "label": "利息"},
        {"tool": "get_cash_interest", "path": "value.other_fees", "label": "费用", "allow_null": true},
        {"tool": "get_cash_interest", "path": "value.avg_month_end_cash", "label": "现金", "allow_null": true},
        {"tool": "get_cash_interest", "path": "value.implied_annual_yield_pct", "label": "收益率", "allow_null": true}
      ],
      "semantic_fact_paths": [
        {"tool": "get_cash_interest", "paths": ["value", "warnings"]}
      ],
      "semantic_rubric": [
        {
          "id": "explain-cash-interest-basis",
          "criterion": "应回答现金利息和工具可计算的隐含收益率；说明该收益率是基于平均月末现金的近似值，并遵守工具警告。若工具返回收益率为空，应明确说明数据不足而非编造。"
        }
      ],
      "must_not": [],
      "expect_note": false
    },
    {
      "id": "DQ08",
      "name": "累计盈亏最大合约",
      "question": "历史上盈亏最大的合约是什么？最差的是哪个？",
      "expected_tools": ["get_top_contributors"],
      "must_include": [],
      "tool_value_assertions": [
        {"tool": "get_top_contributors", "path": "value.winners.0.symbol"},
        {"tool": "get_top_contributors", "path": "value.winners.0.pnl", "label_path": "value.winners.0.symbol"},
        {"tool": "get_top_contributors", "path": "value.losers.0.symbol"},
        {"tool": "get_top_contributors", "path": "value.losers.0.pnl", "label_path": "value.losers.0.symbol"}
      ],
      "semantic_fact_paths": [
        {"tool": "get_top_contributors", "paths": ["value.winners.0", "value.losers.0", "warnings"]}
      ],
      "must_not": [],
      "semantic_rubric": [
        {
          "id": "explain-contributor-time-scope",
          "criterion": "应准确说明工具返回的是合约级累计盈亏排名，不能将其说成某个具体月份或成交时间段的盈亏。"
        }
      ],
      "expect_note": false
    },
    {
      "id": "DQ09",
      "name": "风险指标：回撤与夏普",
      "question": "最大回撤是多少，恢复情况如何？夏普比率是多少？",
      "expected_tools": ["get_risk_measures"],
      "must_include": [],
      "must_not": [],
      "semantic_fact_paths": [
        {"tool": "get_risk_measures", "paths": ["value"]}
      ],
      "semantic_rubric": [
        {
          "id": "risk-measures-coverage",
          "criterion": "应根据工具返回的风险指标正确报告最大回撤、恢复情况和夏普比率，正确区分每项指标，且说明指标基于月度数据；不得称其为日内或日度回撤。"
        }
      ],
      "expect_note": false
    },
    {
      "id": "DQ10",
      "name": "当前持仓与币种现金",
      "question": "现在的持仓配置和 SGD/USD 现金分别是多少？",
      "expected_tools": ["get_open_positions"],
      "must_include": ["SGD", "USD", "市值口径"],
      "tool_value_assertions": [
        {"tool": "get_open_positions", "path": "value.positions.0.as_of_date"}
      ],
      "must_not": [],
      "semantic_fact_paths": [
        {
          "tool": "get_open_positions",
          "paths": [
            "value.positions", "value.market_value_total",
            "value.asset_class_weights", "value.cash_net_weight_pct", "warnings"
          ]
        }
      ],
      "semantic_rubric": [
        {
          "id": "report-position-currency-boundary",
          "criterion": "应准确概述工具返回的当前持仓和 SGD/USD 现金数值及对应币种，并明确这是市值口径而非风险敞口；不得混淆外币原值与账户基础币种折算值。"
        }
      ],
      "expect_note": false
    },
    {
      "id": "DQ11",
      "name": "单月归因：收益高的月份",
      "question": "为什么 2025-03 收益这么高？",
      "expected_tools": ["get_month_detail"],
      "must_include": [],
      "tool_value_assertions": [
        {"tool": "get_month_detail", "path": "return.twr_pct"},
        {"tool": "get_month_detail", "path": "return.benchmarks_pct.SPXTR", "label": "SPXTR"},
        {"tool": "get_month_detail", "path": "profit_sgd", "label": "盈亏"},
        {"tool": "get_month_detail", "path": "flows.deposits", "label": "入金"},
        {"tool": "get_month_detail", "path": "contribution_pp.futures", "label": "期货"},
        {"tool": "get_month_detail", "path": "contribution_pp.futures_options", "labels": ["期货期权", "期货/期权"]},
        {"tool": "get_month_detail", "path": "contribution_pp.derivatives_merged", "label": "合并衍生品"},
        {"tool": "get_month_detail", "path": "contribution_pp.cash", "label": "现金类贡献"},
        {"tool": "get_month_detail", "path": "cash_category.interest_exact", "label": "利息"},
        {"tool": "get_month_detail", "path": "cash_category.fees_exact", "label": "费用"},
        {"tool": "get_month_detail", "path": "cash_category.unexplained_sgd_estimate", "label": "未解释"}
      ],
      "semantic_fact_paths": [
        {
          "tool": "get_month_detail",
          "paths": [
            "month", "return", "nav", "flows", "profit_sgd", "contribution_pp",
            "cash_category", "boundary", "caveats", "warnings"
          ]
        }
      ],
      "must_not": [],
      "semantic_rubric": [
        {
          "id": "monthly-attribution-boundaries",
          "criterion": "应依据工具报告 PA 类别的原始贡献并区分百分点贡献、估算 SGD 分摊与账户 TWR；说明期货和期货期权可能因行权产生类别转移、提供合并视角但不得断言本月发生行权或具体因果。不得把类别贡献说成已实现盈亏。还应正确说明出入金不是投资收益并遵守其他工具边界。"
        }
      ],
      "expect_note": false
    },
    {
      "id": "DQ12",
      "name": "单月归因：解释归因数据不一致",
      "question": "为什么 2025-04 亏损？",
      "expected_tools": ["get_month_detail"],
      "must_include": [],
      "tool_value_assertions": [
        {"tool": "get_month_detail", "path": "return.twr_pct", "require_source_path": true},
        {"tool": "get_month_detail", "path": "contribution_pp.futures", "require_source_path": true},
        {"tool": "get_month_detail", "path": "contribution_pp.futures_options", "require_source_path": true},
        {"tool": "get_month_detail", "path": "contribution_pp.derivatives_merged", "require_source_path": true},
        {"tool": "get_month_detail", "path": "contribution_pp.cash", "require_source_path": true},
        {"tool": "get_month_detail", "path": "contribution_pp.sum", "require_source_path": true},
        {"tool": "get_month_detail", "path": "contribution_pp.twr_gap_pp", "require_source_path": true}
      ],
      "semantic_fact_paths": [
        {
          "tool": "get_month_detail",
          "paths": [
            "month", "return", "contribution_pp", "composition_unavailable_reason",
            "boundary", "caveats", "warnings"
          ]
        }
      ],
      "must_not": [],
      "semantic_rubric": [
        {
          "id": "identify-attribution-inconsistency",
          "criterion": "应说明 PA 原始类别贡献仍可报告，但类别合计与 TWR 不一致时不能作为整体 TWR 的完整对账拆分，也不能据此估算各类别 SGD 盈亏或确定整体亏损原因。"
        },
        {
          "id": "avoid-unsupported-loss-causality",
          "criterion": "不得把类别贡献表述为已实现盈亏或账户整体亏损的确定原因，也不得归因于具体合约/交易、市场回调或笼统组合表现，除非工具结果明确支持该因果结论。"
        },
        {
          "id": "explain-derivative-classification",
          "criterion": "应以 PA 口径说明期货和期货期权类别可能因行权发生转移，并提供两类合并视角；不得推断该月确实发生了行权，也不得推断两类必然来自同一合约或事件。"
        }
      ],
      "expect_note": false
    },
    {
      "id": "DQ13",
      "name": "单月归因：现金类未解释部分",
      "question": "2025-03 现金类为什么有 1.14 个百分点，是美元升值吗？",
      "expected_tools": ["get_month_detail"],
      "must_include": [],
      "tool_value_assertions": [
        {"tool": "get_month_detail", "path": "contribution_pp.cash", "label": "现金类贡献"},
        {"tool": "get_month_detail", "path": "cash_category.interest_exact", "label": "利息"},
        {"tool": "get_month_detail", "path": "cash_category.fees_exact", "label": "费用"},
        {"tool": "get_month_detail", "path": "cash_category.unexplained_sgd_estimate", "label": "未解释"}
      ],
      "semantic_fact_paths": [
        {
          "tool": "get_month_detail",
          "paths": [
            "month", "contribution_pp", "cash_category", "flows", "boundary", "caveats", "warnings"
          ]
        }
      ],
      "must_not": [],
      "semantic_rubric": [
        {
          "id": "cash-attribution-uncertainty",
          "criterion": "应区分现金类别 PA 贡献、精确利息/费用与未解释估算金额；未解释金额的具体来源不能确认，可能包括汇率折算或其他未分类因素。不得仅因没有入金出金就断言为汇率变化，也不得把未解释金额断言为美元升值、利息或费用。"
        }
      ],
      "expect_note": false
    },
    {
      "id": "DQ14",
      "name": "超出报告能力：逐笔成交时间",
      "question": "每月交易笔数是多少？是不是交易太频繁？",
      "expected_tools": ["get_capabilities"],
      "optional_tools": [],
      "must_include": [],
      "must_not": [],
      "semantic_fact_paths": [
        {
          "tool": "get_capabilities",
          "paths": [
            "value.source", "value.period", "value.answerable",
            "value.answerable_with_caveats", "value.not_answerable", "value.constraints"
          ]
        }
      ],
      "semantic_rubric": [
        {
          "id": "trade-count-capability-boundary",
          "criterion": "应明确说明现有报告无法给出逐笔交易笔数或判断交易是否过于频繁，并指出需要逐笔成交时间/交易记录；不得用合约到期月份冒充成交月份。"
        }
      ],
      "expect_note": false
    },
    {
      "id": "DQ15",
      "name": "超出报告能力：杠杆与保证金",
      "question": "这份报告能告诉我账户杠杆是多少吗？",
      "expected_tools": ["get_capabilities"],
      "must_include": [],
      "must_not": [],
      "semantic_fact_paths": [
        {
          "tool": "get_capabilities",
          "paths": [
            "value.source", "value.period", "value.not_answerable", "value.constraints"
          ]
        }
      ],
      "semantic_rubric": [
        {
          "id": "leverage-capability-boundary",
          "criterion": "应明确说明报告不能提供或推断账户杠杆/保证金水平，并解释缺少所需数据；不得从持仓名义值自行推断杠杆。"
        }
      ],
      "expect_note": false
    }
  ]
}
